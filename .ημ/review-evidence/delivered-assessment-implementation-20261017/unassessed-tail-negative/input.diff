+# SPDX-License-Identifier: GPL-3.0-or-later
+name: Scoped graph recall verification
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, ready_for_review]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  verify:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Verify selected checkout
+        env:
+          EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+        run: |
+          actual_head="$(git rev-parse HEAD)"
+          if [ "$actual_head" != "$EXPECTED_HEAD" ]; then
+            echo "::error::Checkout does not match the selected head" >&2
+            exit 1
+          fi
+          echo "Verified exact checkout: $actual_head"
+      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
+        with:
+          distribution: temurin
+          java-version: "21"
+      - uses: DeLaGuardo/setup-clojure@6d46099eae24853c33c0482f2bb54edf4f1a4c74 # 13
+        with:
+          cli: "1.12.2.1565"
+          clj-kondo: "2025.07.28"
+      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
+        with:
+          version: "10.11.0"
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version: "22.20.0"
+      - name: Install the four bounded dependency packages
+        run: pnpm --dir packages --filter @open-hax/openplanner-sdk... --filter @open-hax/openplanner-graph-claim-core... install --frozen-lockfile
+      - name: Build and test the imported cache
+        working-directory: packages/stores/cache
+        run: |
+          set -euo pipefail
+          pnpm exec shadow-cljs release lib --force-spawn 2>&1 | tee "$RUNNER_TEMP/bounded-cache-release.log"
+          grep -Eq 'Build completed\..* 0 warnings[,)]' "$RUNNER_TEMP/bounded-cache-release.log"
+          pnpm exec shadow-cljs compile test --force-spawn 2>&1 | tee "$RUNNER_TEMP/bounded-cache-test-compile.log"
+          grep -Eq 'Build completed\..* 0 warnings[,)]' "$RUNNER_TEMP/bounded-cache-test-compile.log"
+          node target/test.cjs 2>&1 | tee "$RUNNER_TEMP/bounded-cache-test.log"
+          grep -Eq '^0 failures, 0 errors\.$' "$RUNNER_TEMP/bounded-cache-test.log"
+      - name: Build and test the imported hydration library
+        working-directory: packages/stores/document-hydration
+        run: |
+          set -euo pipefail
+          pnpm exec shadow-cljs release lib --force-spawn 2>&1 | tee "$RUNNER_TEMP/bounded-hydration-release.log"
+          grep -Eq 'Build completed\..* 0 warnings[,)]' "$RUNNER_TEMP/bounded-hydration-release.log"
+          pnpm exec shadow-cljs compile test --force-spawn 2>&1 | tee "$RUNNER_TEMP/bounded-hydration-test-compile.log"
+          grep -Eq 'Build completed\..* 0 warnings[,)]' "$RUNNER_TEMP/bounded-hydration-test-compile.log"
+          node target/test.cjs 2>&1 | tee "$RUNNER_TEMP/bounded-hydration-test.log"
+          grep -Eq '^0 failures, 0 errors\.$' "$RUNNER_TEMP/bounded-hydration-test.log"
+      - name: Build the imported SDK and import its released exports
+        run: |
+          set -euo pipefail
+          pnpm --dir packages --filter @open-hax/openplanner-sdk build
+          pnpm --dir packages --filter @open-hax/openplanner-sdk test
+          pnpm --dir packages --filter @open-hax/openplanner-sdk exec node --input-type=module -e 'import("./dist/index.js").then(m => { if (typeof m.createOpenPlannerSdk !== "function") throw new Error("missing SDK entry point"); })'
+      - name: Actual documented Mongo transaction fixture
+        # Starts only a uniquely owned disposable Mongo fixture; no application runtime.
+        run: |
+          docker pull mongo:7
+          node packages/openplanner-sdk/scripts/verify-compose-mongo.mjs
+      - name: Portable recall laws
+        working-directory: packages/graph/graph-claim-core
+        run: clojure -M:recall-test
+      - name: Changed recall namespace lint
+        working-directory: packages/graph/graph-claim-core
+        run: clj-kondo --lint src/openplanner/graph/recall test/openplanner/graph/recall
+      - name: Actual Node suites and forced assertion failure
+        working-directory: packages/graph/graph-claim-core
+        run: |
+          set -euo pipefail
+          pnpm exec shadow-cljs compile test --force-spawn 2>&1 | tee "$RUNNER_TEMP/scoped-recall-test-compile.log"
+          grep -Eq 'Build completed\..* 0 warnings[,)]' "$RUNNER_TEMP/scoped-recall-test-compile.log"
+          node scripts/verify-recall-test-exit.mjs
+      - name: Released ESM and runnable scoped recall demonstration
+        working-directory: packages/graph/graph-claim-core
+        run: |
+          set -euo pipefail
+          pnpm exec shadow-cljs release lib --force-spawn 2>&1 | tee "$RUNNER_TEMP/scoped-recall-release.log"
+          grep -Eq 'Build completed\..* 0 warnings[,)]' "$RUNNER_TEMP/scoped-recall-release.log"
+          node scripts/verify-scoped-recall.mjs
+          node scripts/verify-sdk-query-format.mjs
